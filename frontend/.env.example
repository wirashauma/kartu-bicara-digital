# ==============================================================================
# KARTU BICARA DIGITAL - FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Model Pembelajaran Kooperatif Time Token Arends
# Salin file ini menjadi .env.local (pengembangan lokal) atau .env (deployment)
# Variabel dengan awalan NEXT_PUBLIC_ otomatis dapat diakses oleh browser.
# ==============================================================================

# Aplikasi & Lingkungan
NEXT_PUBLIC_APP_NAME="Kartu Bicara Digital"
NEXT_PUBLIC_APP_ENV=development

# Konektivitas Backend Express API & WebSocket
# Pada mode dev lokal Next.js rewrite proxy mengarahkan /api ke backend internal
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
BACKEND_INTERNAL_URL=http://localhost:5000

# Konfigurasi Firebase Web Client SDK
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

