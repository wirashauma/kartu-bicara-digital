# ==============================================================================
# KARTU BICARA DIGITAL - ROOT WORKSPACE ENVIRONMENT GUIDE
# ==============================================================================
# Model Pembelajaran Kooperatif Time Token Arends
# Proyek ini menggunakan arsitektur monorepo terpisah:
# 1. /backend  -> Express.js + TypeScript + Socket.io Server (Port 5000)
# 2. /frontend -> Next.js 16 + React 19 Client & SSR (Port 3000)
#
# Untuk mengonfigurasi environment masing-masing:
# - Salin backend/.env.example menjadi backend/.env
# - Salin frontend/.env.example menjadi frontend/.env.local
# ==============================================================================

# Ringkasan Kunci Variabel Backend (backend/.env):
# NODE_ENV=development
# PORT=5000
# CLIENT_ORIGIN=http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# JWT_SECRET=kbd_jwt_super_secret_key_2026_change_in_production
# FIREBASE_API_KEY=AIzaSyCt7EIlSAXz1PIEYe0nIonx1pb_Vfyo9bM
# FIREBASE_PROJECT_ID=kartu-bicara-digital

# Ringkasan Kunci Variabel Frontend (frontend/.env.local):
# NEXT_PUBLIC_APP_NAME="Kartu Bicara Digital"
# NEXT_PUBLIC_API_URL=/api
# NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
# BACKEND_INTERNAL_URL=http://localhost:5000
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCt7EIlSAXz1PIEYe0nIonx1pb_Vfyo9bM
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=kartu-bicara-digital

