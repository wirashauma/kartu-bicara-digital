# ==============================================================================
# KARTU BICARA DIGITAL - BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Salin file ini menjadi .env dan sesuaikan nilainya untuk server Anda.
# ==============================================================================

# Server Network & Environment
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Client & CORS Configuration
CLIENT_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Authentication Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here
JWT_EXPIRES_IN=7d

# Logging Level & Prisma SQL Query Logger (true | false)
LOG_LEVEL=info
PRISMA_LOG=true

# Database (PostgreSQL / Supabase with Prisma)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Firebase Web SDK & Admin Credentials
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_firebase_app_id

